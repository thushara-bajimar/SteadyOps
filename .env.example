# SteadyOps environment configuration (copy to .env and adjust).
# Never commit a real .env file.

# --- Supervisor (demo-stack execution boundary) ---
# Shared secret for the narrow remediation API. If unset, scripts/start_local.py
# generates a random per-run token and passes it to both processes.
SUPERVISOR_TOKEN=
# Separate secret used ONLY by the Failure Lab to inject faults.
CHAOS_TOKEN=
SUPERVISOR_URL=http://127.0.0.1:8100

# --- Demo service endpoints (overridden in docker-compose) ---
FRONTEND_SERVICE_URL=http://127.0.0.1:8101
API_SERVICE_URL=http://127.0.0.1:8102
DATABASE_SERVICE_URL=http://127.0.0.1:8103
DEPENDENCY_SERVICE_URL=http://127.0.0.1:8104

# --- SteadyOps control plane ---
STEADYOPS_DB_PATH=runtime-data/steadyops.db
STEADYOPS_HOST=127.0.0.1
STEADYOPS_PORT=8010
# auto | supervised | dry_run_only
STEADYOPS_AUTONOMY_MODE=auto
STEADYOPS_MONITOR_INTERVAL_S=2
