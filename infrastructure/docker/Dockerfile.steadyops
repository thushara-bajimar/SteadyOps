# SteadyOps control plane + built dashboard. No Docker socket, no shell access to the workload.
FROM node:20-alpine AS ui
WORKDIR /ui
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir fastapi==0.115.6 "uvicorn[standard]==0.34.0" httpx==0.28.1 psutil==6.1.1 pydantic==2.10.4 \
 && useradd --create-home --uid 10001 steadyops
COPY backend/ /app/backend/
COPY --from=ui /ui/dist /app/frontend/dist
RUN mkdir -p /app/runtime-data && chown -R steadyops /app/runtime-data
USER steadyops
WORKDIR /app/backend
EXPOSE 8010
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8010"]
